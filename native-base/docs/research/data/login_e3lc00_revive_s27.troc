# Generated by tools/scripts/make_troc_script.py from login_script_112627.json
# Game build 1.0.0.2976, capture captures/cdmp_packets_20261003-112627.bin; stage E3; LoadingCompleteReq 00.
# Override variables with cdmp_peer --var NAME=VALUE (SAVE_SLOT = the host's slot in E3).
var ACCOUNT u64 1
var SAVE_SLOT u32 1  # slot of capture 112627
learn USER_KEY u32 2646 0  # MainUserDataStartAck
learn CHARACTER_NO u64 2869 5  # CharacterLobbyDataAck
learn PLAYER_KEY u32 2756 0  # MainPlayerDataStartAck
# reactive: on ChangeMoveSessionIDAck send EchoMoveSessionIDReq (solo si Ack @4 == USER_KEY. Visto en 112627 a los 61,9 s tras un AITeleportReq de un mercenario.)

# 1. ConnectCryptogramToServerReq (channel 0)
send ConnectCryptogramToServerReq 2319 -1 
expect 2840 30000  # ConnectCryptogramToServerAck

# 2. LoginUserToFieldServerReq (channel 2)
send LoginUserToFieldServerReq 2490 -1 01000000000000000000000000000000000000
put u64 0 ACCOUNT
expect 2716 30000  # MainUserDataEndAck

# 3. LoginCharacterToFieldServerReq (channel 0)
send LoginCharacterToFieldServerReq 3093 -1 04ffffffffffffff7f01000000d4ab54414242
put u64 1 CHARACTER_NO
put u32 9 SAVE_SLOT
expect 2174 30000  # MoveFieldAck

# 4. MoveFieldCompleteReq (channel 0)
send MoveFieldCompleteReq 2549 0 00
expect 2144 30000  # MoveFieldCompleteAck

# 4b. StartActionReq (channel 0)
send StartActionReq 2223 0 
put u32 0 PLAYER_KEY
wait 200

# 6. LoadingCompleteReq (channel 0)
send LoadingCompleteReq 2445 0 00
expect 2762 30000  # LoadingCompleteAck

# 7. LoginCharacterToGameReq (channel 0)
send LoginCharacterToGameReq 2601 0 -
wait 200

# 8. GameLoadingStartReq (channel 0)
send GameLoadingStartReq 2437 0 -
expect 2174 30000  # MoveFieldAck

# 9. MoveFieldCompleteReq (channel 0)
send MoveFieldCompleteReq 2549 0 00
expect 2144 30000  # MoveFieldCompleteAck
wait 5000  # let the burst of ActorLoadDataAck finish

# 13. LoadingCompleteReq (channel 0)
send LoadingCompleteReq 2445 0 00
expect 2762 30000  # LoadingCompleteAck

# ---- P8 S27 revive (docs/research/s25/reaparicion.md: section 6 and "Implementado"). Hand-made, not generated
# (check_troc_scripts.py does not check it; optd_tests parses and plays it). Everything above is
# login_e3lc00_112627.troc unchanged. After its SECOND LoadingCompleteAck 2762, user 2 revives as the guest of session
# 27 did (guest capture cdmp_packets_20261012-210724, t=1206.700..1206.922): ReviveLoadingReq 2362 `02 00` ->
# ReviveLoadingAck 2993, GameLoadingStartReq 2437 -> LoadingFieldDataAck 2643 + MoveFieldCompletePostAck 3066 (the
# reload in the same field, 0x2BCA3D0, no 2174), ReviveReq 2988 (its key, type 2), PreLoadSequencerReq 2873 (empty),
# a 3067 carrier, then the 2322 for user 2's character is EXPECTED: only observer_milestone_reload_any=1 on the host
# gives it (with 0 or probe the server sends it to the host's character, as in session 27, and the script fails
# there, visibly). Then LoadingCompleteReq 2445 -> LoadingCompleteAck 2762: the load is over on the server too.
# No death first: KillCheatReq 2279 never reaches the host's server from the tunnel (server.cpp blocks every Req whose
# class name has "Cheat"). MEASURED on one PC (12-10, d09254d, cdmp_20261012-234005.log): the server refuses the 2362 of
# a LIVING character - user 2's TS stays empty (TravelRevive: NOT armed) and it is LOGGED OUT (2679 reason 0x10, error
# 0xC0838680) - so this script fails at its expect 2993 against the real server. It is kept for the fake-server test
# (optd_tests) and for the day user 2 can die on one PC; until then the revive is tested on Shadow
# (docs/research/s25/reaparicion.md section 11). The host stands where user 2 enters (Hernand, FieldInfoKey 1).
expect_learned USER_KEY 1000
expect_learned CHARACTER_NO 1000
expect_learned PLAYER_KEY 1000
wait 5000

# 14. ReviveLoadingReq (channel 0): u8 revive type 2 (the nearest revive point), u8 0 (session 27's exact payload)
send S27_ReviveLoadingReq 2362 0 0200
expect 2993 10000  # ReviveLoadingAck

# 15. GameLoadingStartReq (channel 0), empty (+58 ms in session 27)
wait 50
send S27_GameLoadingStartReq 2437 0 -
expect 2643 10000  # LoadingFieldDataAck (the respawn point, same field)
expect 3066 10000  # MoveFieldCompletePostAck

# 16. ReviveReq (channel 0): u32 its character, u8 type 2, u8 0, u8 0, u8 0. Not expected: a living character may
#     be refused (Nak) and the load goes on anyway (the client sends its 2873 next in any case)
send S27_ReviveReq 2988 0 0000000002000000
put u32 0 PLAYER_KEY
wait 60

# 17. PreLoadSequencerReq (channel 0), EMPTY (load state 0x0D; +65 ms after the 2988 in session 27)
send S27_PreLoadSequencerReq 2873 0 -
wait 400

# 18. RegionInOutReq (channel 0), only a CARRIER, as in login_e3lc00_travel_s14_b.troc: the 2322 is emitted at the
#     exit of user 2's next ExecuteTroc >= 300 ms after the drop. Actor key 0, region 1, in.
send S16_RegionInOutReq_carrier 3067 0 0000000001000100
# Only a 2322 NAMING THE PEER'S CHARACTER counts (u32 +0 == PLAYER_KEY): observer_seq_copy_2322=1 also copies the
# host's own 2322 (0xA0100001) to user 2 about 0.4 s after the 2873.
expect 2322 5000 u32 0 PLAYER_KEY  # PlayAllPreLoadSequencerAck for user 2's character (observer_milestone_reload_any=1)
wait 1000

# 19. LoadingCompleteReq (channel 0): the client's 2445 after its load (state 0x17)
send S27_LoadingCompleteReq 2445 0 00
expect 2762 10000  # LoadingCompleteAck
wait 3000
end
