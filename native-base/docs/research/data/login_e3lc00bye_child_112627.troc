# D-53r: login_e3lc00bye_112627 plus the first action of user 2's own child (type 6) after the shared load, as
# the real client does (112627 #3449): its key, layer-0 hash and user 2's position are learned from the server.
# Generated by tools/scripts/make_troc_script.py from login_script_112627.json
# Game build 1.0.0.2976, capture captures/cdmp_packets_20261003-112627.bin; stage E3; LoadingCompleteReq 00; with the child variant.
# Override variables with cdmp_peer --var NAME=VALUE (SAVE_SLOT = the host's slot in E3).
var ACCOUNT u64 1
var SAVE_SLOT u32 1  # slot of capture 112627
var CHILD_HASH u32 0x866C7489  # capa 0 de los registros del hatch (c1g #7431, c4r_d53 #7439) y del perro (112627 #1517)
var POS_X u32 0xC6229BFE  # -10407.0 (112627 #3449 +0x08E)
var POS_Y u32 0x4412A15D  # 586.52
var POS_Z u32 0xC55A839C  # -3496.23
learn USER_KEY u32 2646 0  # MainUserDataStartAck
learn CHARACTER_NO u64 2869 5  # CharacterLobbyDataAck
learn PLAYER_KEY u32 2756 0  # MainPlayerDataStartAck
learn POS_X u32 2174 25  # MoveFieldAck
learn POS_Y u32 2174 29  # MoveFieldAck
learn POS_Z u32 2174 33  # MoveFieldAck
learn_child CHILD_KEY 2005 USER_KEY 6  # ActorLoadDataAck: user 2's own child
learn_child_hash CHILD_HASH  # its layer-0 action hash, if its CC block parses
# reactive: on ChangeMoveSessionIDAck send EchoMoveSessionIDReq (solo si Ack @4 == USER_KEY. Visto en 112627 a los 61,9 s tras un AITeleportReq de un mercenario.)

# 1. ConnectCryptogramToServerReq (channel 0)
send ConnectCryptogramToServerReq 2319 -1 
expect 2840 30000  # ConnectCryptogramToServerAck

# 2. LoginUserToFieldServerReq (channel 2)
send LoginUserToFieldServerReq 2490 -1 01000000000000000000000000000000000000
put u64 0 ACCOUNT
expect 2716 30000  # MainUserDataEndAck

# 3. LoginCharacterToFieldServerReq (channel 0)
send LoginCharacterToFieldServerReq 3093 -1 04ffffffffffffff7f01000000d4ab54414242
put u64 1 CHARACTER_NO
put u32 9 SAVE_SLOT
expect 2174 30000  # MoveFieldAck

# 4. MoveFieldCompleteReq (channel 0)
send MoveFieldCompleteReq 2549 0 00
expect 2144 30000  # MoveFieldCompleteAck

# 4b. StartActionReq (channel 0)
send StartActionReq 2223 0 
put u32 0 PLAYER_KEY
wait 200

# 6. LoadingCompleteReq (channel 0)
send LoadingCompleteReq 2445 0 00
expect 2762 30000  # LoadingCompleteAck

# 7. LoginCharacterToGameReq (channel 0)
send LoginCharacterToGameReq 2601 0 -
wait 200

# 8. GameLoadingStartReq (channel 0)
send GameLoadingStartReq 2437 0 -
expect 2174 30000  # MoveFieldAck

# 9. MoveFieldCompleteReq (channel 0)
send MoveFieldCompleteReq 2549 0 00
expect 2144 30000  # MoveFieldCompleteAck

# 9b. StartActionReq (channel 0) [child]
expect_learned CHILD_KEY 10000
wait 350
send StartActionReq 2223 0 
put u32 0 CHILD_KEY
put u32 0x16C PLAYER_KEY
put u32 8 CHILD_HASH
put u32 0x8E POS_X
put u32 0x92 POS_Y
put u32 0x96 POS_Z
wait 5000  # let the burst of ActorLoadDataAck finish

# 13. LoadingCompleteReq (channel 0)
send LoadingCompleteReq 2445 0 00
expect 2762 30000  # LoadingCompleteAck

# C4a. Goodbye after 20 s in the host's field
wait 20000
logout_session
expect 2003 30000  # LogoutUserToServerAck
expect 2002 30000  # LogoutSessionToServerAck
